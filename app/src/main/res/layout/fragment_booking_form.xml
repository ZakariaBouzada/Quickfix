<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btnBackBookingForm"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/back"
                android:contentDescription="Back"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:tint="#4472C4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Book a repair"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#4472C4" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="QuickFix • Bike repair"
            android:textSize="12sp"
            android:textColor="#555555"
            android:gravity="center" />

        <!-- ── Step 1: Problem type ───────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E1E1E"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#0D0D0D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 1"
                    android:textColor="#4472C4"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:text="What is the problem?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTires"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Tires"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChain"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Chain"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOther"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Other"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="💡 Add a photo for faster diagnosis"
                    android:textColor="#555555"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Step 2: Details ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E1E1E"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#0D0D0D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 2"
                    android:textColor="#4472C4"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:text="Date, location &amp; description"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <!-- Date/Time field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Preferred date &amp; time"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#141414"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="#555555"
                    app:boxStrokeColor="#2A2A2A">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Tap to pick date &amp; time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location — map only -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Location"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <!-- Full-width map button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickOnMap"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📍  Pick location on map"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#4472C4"
                    app:icon="@null" />

                <!-- Picked address display -->
                <TextView
                    android:id="@+id/tvPickedAddressHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="No location selected yet — tap the button above"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Describe the issue"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#141414"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="#555555"
                    app:boxStrokeColor="#2A2A2A">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:hint="e.g. flat tyre, chain slipping, squeaky brakes…"
                        android:gravity="top"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Photo button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📷  Add a photo (optional)"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#181818"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp" />

                <!-- Photo preview -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#0D0D0D">

                    <ImageView
                        android:id="@+id/ivPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit button -->
        <de.timonknispel.ktloadingbutton.KTLoadingButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:buttonName="Confirm booking"
            app:buttonTextSize="15sp"
            app:allCaps="false"
            app:buttonColor="#4472C4"
            app:succeedColor="#4472C4"
            app:failedColor="@color/quickfix_purple" />

        <!-- Hidden status views (kept for code compatibility) -->
        <TextView
            android:id="@+id/tvMyBookingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My booking"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status"
            android:textColor="#BDBDBD"
            android:textStyle="bold"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatusDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Hidden confirm-completed (kept for code compatibility) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCompleted"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="Confirm completed"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:backgroundTint="#4472C4"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
