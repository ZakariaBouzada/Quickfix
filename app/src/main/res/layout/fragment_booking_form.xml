<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: back left + title centered -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp">

            <ImageButton
                android:id="@+id/btnBackBookingForm"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/back"
                android:contentDescription="Back"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:tint="#FFFF00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Book a repair"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="#FFFF00" />

        </FrameLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose a problem type, preferred time and add the location!"
            android:textSize="14sp"
            android:textColor="#BDBDBD" />

        <!-- Problem type card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#101010">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What is the problem?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTires"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Tires"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChain"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Chain"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOther"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Other"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Form card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#101010">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Preferred date and time"
                    android:background="@android:color/transparent"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:padding="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1F1F1F" />

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Location in Turku"
                    android:background="@android:color/transparent"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:padding="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1F1F1F" />

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="Describe the issue"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:padding="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="Add photo"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#202020"
                    app:strokeColor="#FFFF00"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:id="@+id/ivPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- This is your circular loading confirm button -->
                <de.timonknispel.ktloadingbutton.KTLoadingButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    app:buttonName="Submit booking"
                    app:buttonTextSize="14sp"
                    app:allCaps="false"
                    app:buttonColor="@color/quickfix_yellow"
                    app:succeedColor="@color/quickfix_yellow"
                    app:failedColor="@color/quickfix_purple" />



                <!-- Customer confirms completion (hidden until status completed_pending) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="Confirm completed"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#FFFF00"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMyBookingHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My booking"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Status"
                    android:textColor="#BDBDBD"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatusDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
