<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btnBackVehicleForm"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/back"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:tint="#FFFF00"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvVehicleFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Book a repair"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#FFFF00" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="QuickFix • Vehicle repair"
            android:textSize="12sp"
            android:textColor="#555555"
            android:gravity="center" />

        <!-- ── Step 1: Vehicle details ────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E1E1E"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#0D0D0D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 1"
                    android:textColor="#FFFF00"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"
                    android:text="Vehicle details"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <!-- Brand label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Brand"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <!-- Brand spinner -->
                <Spinner
                    android:id="@+id/spinnerBrand"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:popupBackground="#1A1A1A" />

                <!-- Model label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Model (optional)"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#141414"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="#555555"
                    app:boxStrokeColor="#2A2A2A">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModel"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="e.g. Golf, Civic, CBR600"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Year label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Year (optional)"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#141414"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="#555555"
                    app:boxStrokeColor="#2A2A2A">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYear"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="e.g. 2019"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="number"
                        android:maxLength="4" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Step 2: Problem type ───────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E1E1E"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#0D0D0D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 2"
                    android:textColor="#FFFF00"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:text="What is the problem?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEngine"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Engine"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBrakes"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Brakes"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTiresV"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Tires"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOtherV"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Other"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Step 3: Booking details ───────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E1E1E"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#0D0D0D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 3"
                    android:textColor="#FFFF00"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:text="Date, location &amp; description"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <!-- Date/Time -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Preferred date &amp; time"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#141414"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="#555555"
                    app:boxStrokeColor="#2A2A2A">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDateTimeV"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Tap to pick date &amp; time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location — map only -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Location"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickOnMapV"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📍  Pick location on map"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFF00"
                    app:icon="@null" />

                <!-- Picked address display -->
                <TextView
                    android:id="@+id/tvPickedAddressHintV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="No location selected yet — tap the button above"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Describe the issue"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#141414"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="#555555"
                    app:boxStrokeColor="#2A2A2A">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescriptionV"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:hint="e.g. engine noise, brake fade, flat tyre…"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Photo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPhotoV"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📷  Add a photo (optional)"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#181818"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:id="@+id/ivPhotoPreviewV"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit -->
        <de.timonknispel.ktloadingbutton.KTLoadingButton
            android:id="@+id/btnConfirmV"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:buttonName="Confirm booking"
            app:buttonColor="#FFFF00"
            app:buttonTextSize="15sp"
            app:allCaps="false"
            app:succeedColor="#FFFF00"
            app:failedColor="#9C27B0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
