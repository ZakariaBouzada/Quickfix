<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBackVehicleForm"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/back"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:tint="#FFFF00"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvVehicleFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Book a repair"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>

        <!-- Vehicle info card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#101010">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Vehicle details"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFF00" />

                <!-- Brand spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Brand"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA" />

                <Spinner
                    android:id="@+id/spinnerBrand"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FFFFFF"
                    android:popupBackground="#1A1A1A" />

                <!-- Model -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="Model (optional)"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#0F0F0F"
                    app:boxStrokeColor="#333333"
                    app:hintTextColor="#777777"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Golf, Civic, CBR600"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:background="#0F0F0F"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Year -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="Year (optional)"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#0F0F0F"
                    app:boxStrokeColor="#333333"
                    app:hintTextColor="#777777"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 2019"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:background="#0F0F0F"
                        android:inputType="number"
                        android:maxLength="4" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Problem type card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#101010">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Problem type"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFF00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEngine"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Engine"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBrakes"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="Brakes"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTiresV"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="Tires"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOtherV"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Other"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Date, location, description card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#101010">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Booking details"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFF00" />

                <!-- Date/Time -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:boxBackgroundColor="#0F0F0F"
                    app:boxStrokeColor="#333333"
                    app:hintTextColor="#777777"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDateTimeV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date &amp; time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:background="#0F0F0F"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:boxBackgroundColor="#0F0F0F"
                        app:boxStrokeColor="#333333"
                        app:hintTextColor="#777777"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLocationV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Location"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#555555"
                            android:background="#0F0F0F"
                            android:inputType="textPostalAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/btnPickOnMapV"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_map_pin"
                        android:background="#FFFF00"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:contentDescription="Pick on map" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPickedAddressHintV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Tip: use the map button to pin your exact location"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <!-- Description -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:boxBackgroundColor="#0F0F0F"
                    app:boxStrokeColor="#333333"
                    app:hintTextColor="#777777"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescriptionV"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:hint="Describe the issue"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#555555"
                        android:background="#0F0F0F"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Photo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPhotoV"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📷  Add a photo (optional)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#1E1E1E"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:id="@+id/ivPhotoPreviewV"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit -->
        <de.timonknispel.ktloadingbutton.KTLoadingButton
            android:id="@+id/btnConfirmV"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:buttonName="Confirm booking"
            app:buttonColor="#FFFF00"
            app:buttonTextSize="14sp"
            app:allCaps="false"
            app:succeedColor="#FFFF00"
            app:failedColor="#9C27B0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
