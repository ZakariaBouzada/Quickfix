<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCompleted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:title="Completed repairs"
        app:titleTextColor="#4472C4"
        app:navigationIcon="@android:drawable/ic_media_previous" />

    <TextView
        android:id="@+id/tvMechanicCompletedSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:text="Your finished jobs."
        android:textColor="#BDBDBD" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCompleted"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

</LinearLayout>
