<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/homeFragment">


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.bikerepairapp.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.bikerepairapp.ui.booking.BookingFragment"
        android:label="Booking">

        <!-- Book a repair -> BookingForm -->
        <action
            android:id="@+id/action_bookingFragment_to_bookingFormFragment"
            app:destination="@id/bookingFormFragment" />

        <!-- My repairs -> CustomerRepairs -->
        <action
            android:id="@+id/action_bookingFragment_to_customerRepairsFragment"
            app:destination="@id/customerRepairsFragment" />
    </fragment>

    <!-- NEW: Full booking form screen -->
    <fragment
        android:id="@+id/bookingFormFragment"
        android:name="com.example.bikerepairapp.ui.booking.BookingFormFragment"
        android:label="Book a repair" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.bikerepairapp.ui.profile.ProfileFragment"
        android:label="Profile" />

    <!-- You already have this fragment -->
    <fragment
        android:id="@+id/customerRepairsFragment"
        android:name="com.example.bikerepairapp.ui.repairs.CustomerRepairsFragment"
        android:label="Repairs">
        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="all" />
        <argument
            android:name="highlightRequestId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <dialog
        android:id="@+id/notificationOverlayFragment"
        android:name="com.example.bikerepairapp.notifications.NotificationOverlayFragment"
        android:label="Notifications" />

</navigation>

