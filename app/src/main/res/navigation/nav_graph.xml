<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.bikerepairapp.ui.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_helpFragment"
            app:destination="@id/helpFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.bikerepairapp.ui.booking.BookingFragment"
        android:label="Booking">

        <action
            android:id="@+id/action_bookingFragment_to_vehiclePickerFragment"
            app:destination="@id/vehiclePickerFragment" />

        <action
            android:id="@+id/action_bookingFragment_to_customerRepairsFragment"
            app:destination="@id/customerRepairsFragment" />
    </fragment>

    <!-- Vehicle type picker (new) -->
    <fragment
        android:id="@+id/vehiclePickerFragment"
        android:name="com.example.bikerepairapp.ui.booking.VehiclePickerFragment"
        android:label="Select Vehicle">

        <!-- Bike → existing bike form -->
        <action
            android:id="@+id/action_vehiclePickerFragment_to_bookingFormFragment"
            app:destination="@id/bookingFormFragment" />

        <!-- Car or Motorbike → new vehicle form -->
        <action
            android:id="@+id/action_vehiclePickerFragment_to_vehicleBookingFormFragment"
            app:destination="@id/vehicleBookingFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingFormFragment"
        android:name="com.example.bikerepairapp.ui.booking.BookingFormFragment"
        android:label="Book a repair" />

    <!-- Car / Motorbike booking form (new) -->
    <fragment
        android:id="@+id/vehicleBookingFormFragment"
        android:name="com.example.bikerepairapp.ui.booking.VehicleBookingFormFragment"
        android:label="Book a repair">

        <argument
            android:name="vehicleType"
            android:defaultValue="Car"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.bikerepairapp.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/customerRepairsFragment"
        android:name="com.example.bikerepairapp.ui.repairs.CustomerRepairsFragment"
        android:label="Repairs">
        <argument
            android:name="mode"
            android:defaultValue="all"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.bikerepairapp.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.example.bikerepairapp.ui.help.HelpFragment"
        android:label="Help" />

</navigation>
